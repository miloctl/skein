.run/
__pycache__/
*.pyc

# agent worktrees (Claude Code tooling scratch, never project state)
# session tooling: settings.local.json holds permission allowlists,
# RESUME.md holds session notes; neither belongs in a public tree
.claude/

# session scaffolding: the spec/plan/todo a working session writes. The open
# backlog has ONE home (docs/ROADMAP.md) and a closed plan is archived to
# docs/reviews/ with a date — a third copy is what the 2026-08-02
# consolidation existed to undo.
tasks/
backend/build/
# mutmut's generated tree and result cache (scripts/mutation-test.sh)
backend/mutants/
# coverage's own SQLite artifact (embeds absolute local paths, changes on
# every run, and CI measures coverage from a clean checkout)
.coverage
.coverage.*
# setuptools metadata that `pip install -e` writes into src/ (the CI
# extension step runs one) — regenerated on every install, never source
*.egg-info/
