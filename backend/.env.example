# Model provider: mock (default, no keys needed) | anthropic | openai
STRANDS_MODEL_PROVIDER=mock
# Defaults: mock / claude-opus-4-8 (anthropic) / gpt-5 (openai). Override:
# STRANDS_MODEL_ID=claude-opus-4-8
STRANDS_MAX_TOKENS=4096

# Credentials (only needed for the matching provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Agent writes go to the review inbox instead of applying directly (0/1)
STRANDS_AGENT_REVIEW=0
# Background jobs: hourly blocker sweep, daily digest + backup (0/1)
STRANDS_SCHEDULER=1
# Optional semantic search (needs OPENAI_API_KEY): 0/1
STRANDS_EMBEDDINGS=0

STRANDS_CORS_ORIGINS=http://localhost:3000
