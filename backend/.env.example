# Model provider: anthropic | openai
STRANDS_MODEL_PROVIDER=anthropic
# Defaults: claude-opus-4-8 (anthropic) / gpt-5 (openai). Override if needed:
# STRANDS_MODEL_ID=claude-opus-4-8
STRANDS_MAX_TOKENS=4096

# Credentials (only the one matching your provider is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

STRANDS_CORS_ORIGINS=http://localhost:3000
