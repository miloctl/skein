# Model provider. Every one of these is optional — with mock (the default)
# the whole product still works, deterministically.
#   mock              no model at all; commands + rule-based capture
#   ollama            keyless, local daemon or Ollama Cloud after signin
#   openai            OPENAI_API_KEY
#   openai_compatible anything speaking the OpenAI wire format — vLLM,
#                     LM Studio, llama.cpp, OpenRouter, Together, Groq,
#                     Azure OpenAI, LiteLLM Proxy. Needs SKEIN_MODEL_BASE_URL.
#   anthropic         ANTHROPIC_API_KEY
#   bedrock           no key — uses the ambient AWS credential chain.
#                     Needs SKEIN_MODEL_ID: Claude ids there require a
#                     region-dependent inference-profile prefix
#                     (us./eu./apac./global.), so there is no safe default.
SKEIN_MODEL_PROVIDER=mock
# Default model per provider: claude-opus-4-8 / gpt-5 / gpt-oss:120b-cloud.
# openai_compatible and bedrock have no default and require this.
# SKEIN_MODEL_ID=
# Required for openai_compatible, and REFUSED for every other provider — a
# leftover value would otherwise redirect a paid provider's traffic.
# SKEIN_MODEL_BASE_URL=http://localhost:8001/v1
# Explicit key, overriding the provider-native one (ANTHROPIC_API_KEY,
# OPENAI_API_KEY, OLLAMA_API_KEY). REQUIRED for openai_compatible, which
# never falls back to OPENAI_API_KEY — sending a paid OpenAI key to a
# third-party endpoint is a leak, not a convenience.
# SKEIN_MODEL_API_KEY=
# Output cap. Reaches anthropic, ollama and bedrock. NOT sent to the
# OpenAI family: reasoning models (gpt-5 included) reject max_tokens and
# want max_completion_tokens, so set that through SKEIN_MODEL_PARAMS.
SKEIN_MAX_TOKENS=4096
# Free-form JSON, merged last so operator values always win. Where it lands
# differs by provider: openai/anthropic forward it to the REQUEST
# (temperature, max_completion_tokens, reasoning_effort); ollama/bedrock
# take it as MODEL CONFIG keys (max_tokens, temperature, keep_alive) — for
# ollama, anything else belongs nested, e.g. {"options": {"top_k": 40}}.
# SKEIN_MODEL_PARAMS={"temperature": 0.2}

# Credentials (only needed for the matching provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Ollama (no key needed): default host is the local daemon, which also proxies
# *-cloud models to Ollama Cloud after `ollama signin`. To use Ollama Cloud
# without a local daemon, set both of these instead:
# SKEIN_OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=

# Agent writes go to the review inbox instead of applying directly (0/1).
# At 0 a `review`-level write applies straight through and records NO verdict,
# so trust scores never accrue and no agent can ever earn a promotion — the
# Agents page says so rather than showing an empty card
# (services/delegation.py::trust_blocked). Set 1 to collect verdicts.
SKEIN_AGENT_REVIEW=0
# Spend one extra model round trip when a chat turn answers a capture-prefixed
# message and writes nothing, so the agent can still file it (0/1). The turn
# guard's own note costs nothing and is always on; only the retry is optional.
SKEIN_TURN_GUARD=0
# How a long chat is kept inside the model's context window (real providers
# only -- mock builds no Strands agent, so none of this applies there).
#   sliding   = drop the oldest messages. Free.
#   summarize = condense them instead. Costs one extra model call when it fires.
SKEIN_CONTEXT_STRATEGY=sliding
# sliding: how many messages to keep. Older messages are dropped.
SKEIN_CONTEXT_WINDOW_MESSAGES=40
# summarize: share of the oldest messages folded into the summary (0.1-0.8)
SKEIN_CONTEXT_SUMMARY_RATIO=0.3
# summarize: recent messages never summarized away
SKEIN_CONTEXT_PRESERVE_RECENT=10
# Both: opening messages the SDK holds during a turn. This does NOT survive a
# turn boundary -- session restore skips exactly these messages -- so the knob
# has no effect on Skein's file-backed chats today. Left wired for when it does.
SKEIN_CONTEXT_PIN_FIRST=0
# Both: compress before an overflow instead of after (0/1). The threshold is
# 70% of the MODEL's token context window, not of SKEIN_CONTEXT_WINDOW_MESSAGES above.
# Skein sets no context_window_limit, so the SDK assumes 200k tokens -- on a
# smaller local model this never fires and reactive recovery handles it.
SKEIN_CONTEXT_PROACTIVE=0
# The model menu: models an administrator can pick between in Settings,
# with optional per-model tuning. Empty = no menu, the picker stays hidden.
# Schema (for your editor): backend/schemas/skein_models.schema.json.
# Any invalid entry voids the whole list and /health says why. On upgrade,
# roll the image before or with this variable -- an old server reads a new
# field as a typo.
# SKEIN_MODELS=[{"id": "claude-opus-4-8", "label": "Opus", "price": {"input": 5, "output": 25}}]
# Cost estimates per model: {"model-id": [usd_per_mtok_in, usd_per_mtok_out]}.
# Empty = no costs are estimated (cost NULL, honest not zero). A shipped
# default would go stale, so the prices are yours to set and keep current.
# A price in SKEIN_MODELS wins over this table for that model id.
# SKEIN_MODEL_PRICES={"claude-opus-4-8": [5, 25]}
# Monthly team spend ceiling in USD for the budget findings rule. 0 = off.
# SKEIN_MONTHLY_BUDGET_USD=0
# Team time zone: an IANA name, never a fixed offset ("EST" is UTC-5 all year,
# so rituals run an hour late for eight months of it). Rituals, digests and
# every "today" run here; stored timestamps stay UTC ISO-8601. Empty = UTC.
# A name this host has no zone data for degrades to UTC and reports on /health.
# SKEIN_TZ=America/New_York

# Unattended agent runs (services/agent_runner.py). Empty = OFF, which is the
# default: nothing wakes an agent unless an operator names it here.
# An ALLOWLIST of agent identities, comma-separated — never "everyone with
# open work", which grows one every time somebody delegates to a new name.
# SKEIN_AGENT_RUNNER=research-agent,planner-agent
# Daily token ceiling per agent for those runs. 0 = no ceiling. Tokens, not
# dollars: an unpriced model costs NULL, so a dollar cap binds on nothing
# exactly where a keyless or subscription deployment needs one.
# SKEIN_AGENT_DAILY_TOKENS=0
# Wall clock for ONE unattended turn. The provider socket timeout caps a
# stall, never a loop that keeps making progress it cannot finish.
# SKEIN_AGENT_RUN_SECONDS=300

# Background jobs: hourly blocker sweep, daily digest + backup (0/1)
SKEIN_SCHEDULER=1
# Thread-pool sizes, chosen at startup (config.py records the measurement:
# smaller pools are FASTER for this workload until requests queue on a
# genuinely blocking call, like a 5s embedding round trip). THREAD_POOL
# serves every REST handler; TOOL_THREADS serves agent tool calls — unset,
# Python sizes the second one from the host's CPU count, so a laptop and a
# small VM silently got different ceilings.
# SKEIN_THREAD_POOL=8
# SKEIN_TOOL_THREADS=16
# Optional semantic search: 0/1. Provider is independent of the chat
# provider (anthropic/bedrock have no embeddings endpoint, and vectors
# persist — a chat switch must not invalidate them).
#
# To turn it on, keyless, with a local Ollama daemon — all four steps:
#   1. ollama pull nomic-embed-text
#      A daemon that serves *-cloud chat models has NO local models, so this
#      step is required even when chat already works.
#   2. Set the three variables below:
#      SKEIN_EMBEDDINGS=1
#      SKEIN_EMBED_PROVIDER=ollama
#      SKEIN_EMBED_MODEL=nomic-embed-text
#   3. Restart the server. Config is read once, at import.
#   4. python -m app.backfill_embeddings
#      Records embed on write, so records that already exist have no vector
#      and stay invisible to semantic search until this runs.
# Then check the floor below against your own data.
SKEIN_EMBEDDINGS=0
# openai (default, needs OPENAI_API_KEY) | openai_compatible (needs
# SKEIN_EMBED_BASE_URL, never inherits OPENAI_API_KEY) | ollama (keyless)
# SKEIN_EMBED_PROVIDER=openai
# SKEIN_EMBED_BASE_URL=
# SKEIN_EMBED_API_KEY=
# Embedding model. Default for openai: text-embedding-3-small. Required
# for ollama/openai_compatible. Changing it invalidates stored vectors
# (tagged per model). Records embed on write, so after enabling this or
# switching models, vectorize existing records once:
#   python -m app.backfill_embeddings   (idempotent; --dry-run to count)
# SKEIN_EMBED_MODEL=
# Cosine floor a semantic hit must clear (default 0.5). Below it, a query
# that matches nothing still fills the page with the least-dissimilar rows,
# and search can never answer "nothing matches those words". The right value
# is per model — each embedding space has its own noise floor. To tune it,
# search a deliberate nonsense string, read the top score, and set this
# above it. nomic-embed-text measures ~0.50 for nonsense and ~0.65 for a
# real match, so 0.52 suits it; text-embedding-3-small runs lower on both.
# SKEIN_EMBED_MIN_SCORE=0.5

SKEIN_CORS_ORIGINS=http://localhost:3000

# ---- optional integrations (each activates only when set) ----
# Slack: outbound notifications/digests + inbound /api/slack/command
SLACK_WEBHOOK_URL=
SLACK_SIGNING_SECRET=
# MCP servers for the real agent (JSON list of {name,url,auth_token})
SKEIN_MCP_SERVERS=
# Opt-in prebuilt tools (strands-agents-tools) for the real agent.
# Strict allowlist — see app/agents/extra_tools.py for what's loadable and
# why the rest (shell, http_request, use_agent, workflow, ...) is not.
# Suggested keyless set:
# SKEIN_EXTRA_TOOLS=calculator,current_time,think,batch
# Research tools need their own keys: tavily_search (TAVILY_API_KEY),
# exa_search (EXA_API_KEY)
SKEIN_EXTRA_TOOLS=
# OpenTelemetry OTLP endpoint (e.g. http://jaeger:4318)
SKEIN_OTEL_ENDPOINT=
# Data directory override (default: backend/data; the Docker image sets /data)
# SKEIN_DATA_DIR=
# Deployment overlays: directories of extra playbooks (*.yaml), personas
# (*.md + optional pack.json) and flocks (*.yaml), loaded alongside the
# stock ones. An overlay file with the same slug replaces the stock file; an
# overlay pack.json merges field-by-field over the stock pack.json (JSON null
# clears a stock default). Use these to keep deployment-specific content in
# its own repo instead of a fork.
# SKEIN_PLAYBOOKS_DIR=
# SKEIN_PERSONAS_DIR=
# SKEIN_FLOCKS_DIR=
# Backup directory override (default: <data dir>/backups)
# SKEIN_BACKUP_DIR=
# Identity for writes made through the MCP server. Use a name of its own,
# NEVER your own: the API server reserves this name as an agent identity at
# boot, and agent identities are refused on REST and on the private surfaces.
# If you already trapped your own name, free it with
# POST /api/users/<name>/rename (the agent row moves, the name comes back).
# SKEIN_MCP_USER=you-mcp

# How a caller proves who they are (trusted-header | api-key | oidc).
#   trusted-header  identity is the self-asserted X-User header. For a
#                   trusted network or local dev only. Default.
#   api-key         every request needs a personal API key (sk-skein-...).
#                   First key per person: python -m app.bootstrap_key <name>.
#   oidc            humans present an IdP-issued JWT, validated in-process
#                   (JWKS signature, then iss/aud/exp). Personal API keys
#                   still work for automation (CLI, MCP, hooks).
# An unknown value fails closed: every /api request is refused until fixed.
SKEIN_AUTH_MODE=trusted-header
# Administrators (comma-separated names) for the roster / key-visibility /
# authority / team-settings / backup / export surfaces. Empty +
# trusted-header mode = every key holder administers (keys are hand-minted
# and scarce there). Empty in the other modes = those surfaces stay locked
# until this is set, because keys and sign-ins are not scarce there.
# SKEIN_ADMINS=
# oidc mode only:
# SKEIN_OIDC_ISSUER=https://login.example.com/realms/team
# SKEIN_OIDC_AUDIENCE=skein
# JWKS endpoint override. Empty = read jwks_uri from the issuer's
# /.well-known/openid-configuration at first use.
# SKEIN_OIDC_JWKS_URL=
# Claim that names the user (Keycloak sends preferred_username, Entra upn)
# SKEIN_OIDC_USERNAME_CLAIM=preferred_username
# Claim that carries group names, and the group that grants admin
# (works alongside SKEIN_ADMINS)
# SKEIN_OIDC_GROUPS_CLAIM=groups
# SKEIN_OIDC_ADMIN_GROUP=
# Browser sign-in (authorization code + PKCE). Set this to turn on the
# Sign in button in the web app. Register the app in the identity provider
# as a PUBLIC client with no secret, and allow this redirect URI:
#   <web app origin>/auth/callback     for example http://localhost:3000/auth/callback
# There is no client secret setting on purpose: a secret shipped to a
# browser is not a secret, which is what PKCE replaces.
# SKEIN_OIDC_CLIENT_ID=skein-web
# SKEIN_OIDC_SCOPES=openid profile
# Endpoint overrides. Empty = read from the issuer's discovery document.
# SKEIN_OIDC_AUTHORIZE_URL=
# SKEIN_OIDC_TOKEN_URL=

# REQUIRED behind a reverse proxy: how many trusted proxies stand between
# the caller and this server (Skein reads the caller's address that many
# entries from the right of X-Forwarded-For). At the default 0 the header
# is ignored, so behind a proxy every browser shares the proxy's address —
# and one sign-in rate bucket for the whole deployment. Never set it higher
# than the real proxy count: extra hops let a caller pick their own bucket.
# SKEIN_TRUST_PROXY_HOPS=1
# Shared bearer token for the API (trusted-header mode only — the other
# modes already demand a per-caller credential on every request)
SKEIN_API_TOKEN=
# Dedicated secret for the ICS calendar feed URL — never reuse the API token
# (calendar clients store the URL in configs/logs). When SKEIN_API_TOKEN is
# set but this is empty, the feed is disabled.
SKEIN_ICS_TOKEN=
# Shared secret for the code-forge webhook (POST /api/webhooks/forge). Put the
# same secret in the repository webhook settings. Empty closes the endpoint:
# it moves tasks, so an unsigned caller must never reach it.
SKEIN_FORGE_WEBHOOK_SECRET=
# Author-private notes DB (1:1 prep + feedback journal). Separate file that
# backup/export/FTS/MCP/agents never open; created 0600.
# SKEIN_PRIVATE_DB=
# Mirror each daily backup to a second path (mounted NAS/remote). For true
# off-box targets use rclone/rsync in a host cron against data/backups/.
# Also receives its own append of the nightly activity-chain anchor line
# (activity-anchors.log) -- the off-box record a ledger rewrite must contradict.
SKEIN_BACKUP_MIRROR=
