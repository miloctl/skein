# Used only when ATLAS_API_URL is set in the deployment overlay.
ATLAS_API_TOKEN=replace-with-a-secret-reference

# These keys belong in skein-db-secret. The application role is not the
# PostgreSQL bootstrap superuser.
SKEIN_APP_USER=skein_app
SKEIN_APP_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=skein
