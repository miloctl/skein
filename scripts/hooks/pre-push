#!/usr/bin/env bash
# The first mechanical gate a change meets: it runs before the push that starts
# either CI (.gitea/workflows/ci.yml, .github/workflows/ci.yml).
# Install: git config core.hooksPath scripts/hooks
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

# prerequisite checks come first: without them a fresh clone gets a raw
# "command not found" from lint, or a false "tests failed" when no test ran
if [ ! -x backend/.venv/bin/pytest ] || [ ! -x backend/.venv/bin/ruff ]; then
    echo "pre-push: backend/.venv is missing or incomplete. Run the install command in the Setup section of the README, then push again." >&2
    exit 1
fi
if [ ! -d frontend/node_modules ]; then
    echo "pre-push: frontend/node_modules is missing. Run npm ci in frontend/, then push again." >&2
    exit 1
fi

if ! ./scripts/lint.sh; then
    echo "pre-push: lint failed. Fix the errors above, then push again." >&2
    exit 1
fi

if ! (cd backend && .venv/bin/pytest -q -n auto); then
    echo "pre-push: tests failed. Fix the tests that failed, then push again." >&2
    exit 1
fi
