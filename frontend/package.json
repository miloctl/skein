{
  "name": "frontend",
  "version": "0.2.2",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "compose:extensions": "node scripts/compose-extensions.mjs",
    "predev": "npm run compose:extensions",
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "prebuild": "npm run compose:extensions",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "knip": "knip",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest"
  },
  "dependencies": {
    "@skein/extension-api": "file:packages/extension-api",
    "@assistant-ui/react": "^0.14.27",
    "@assistant-ui/react-markdown": "^0.14.6",
    "canvas-confetti": "^1.9.4",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.10"
  },
  "knip": {
    "entry": [
      "lib/extensions/public.tsx"
    ]
  }
}
