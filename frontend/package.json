{
  "name": "@miloctl/skein-frontend-host",
  "version": "0.6.16",
  "private": false,
  "description": "Buildable Skein frontend host for trusted workplace extensions",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miloctl/skein.git",
    "directory": "frontend"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "node": "22.x"
  },
  "bin": {
    "skein-frontend-build": "scripts/skein-frontend-build.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "app",
    "components",
    "lib",
    "public",
    "scripts/compose-extensions.mjs",
    "scripts/skein-frontend-build.mjs",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "compose:extensions": "node scripts/compose-extensions.mjs",
    "predev": "npm run compose:extensions",
    "dev": "NODE_OPTIONS=--max-old-space-size=8192 next dev",
    "prebuild": "npm run compose:extensions",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "knip": "knip",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:coverage": "NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage --coverage.reporter=text-summary",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.25",
    "@assistant-ui/react-markdown": "0.14.19",
    "@tailwindcss/postcss": "4.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "canvas-confetti": "1.9.4",
    "mermaid": "12.1.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@miloctl/skein-extension-api": "1.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@miloctl/skein-extension-api": "file:packages/extension-api",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "knip": "^6.40.0",
    "react-markdown": "^10.1.0",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@assistant-ui/tap": "0.9.21",
    "sharp": "0.35.5",
    "postcss": "8.5.23",
    "katex": "0.18.11"
  },
  "knip": {
    "entry": [
      "lib/extensions/public.tsx"
    ],
    "playwright": {
      "config": [
        "playwright.config.ts",
        "playwright.oidc.config.ts"
      ],
      "entry": [
        "e2e/**/*.spec.ts",
        "e2e-oidc/**/*.spec.ts"
      ]
    }
  }
}
